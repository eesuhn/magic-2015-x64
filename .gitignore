# Generated: rebuild with port/build.sh
/build/*
/dist/
# ...except the card list extracted from the OBB (build/cards/extract_cards.py)
!/build/cards/
*.apk
# ...except the game inputs, which are tracked in Git LFS (see .gitattributes)
!/input/*.apk

# Signing key and its password: secret, back them up outside the repo
/keys/
*.keystore
*.keystore.pass
*.jks

# Third-party tools used once during the investigation
/tools/

# Local
.claude/
__pycache__/
.DS_Store
