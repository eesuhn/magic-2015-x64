    <LOCALISED_TEXT LanguageCode="de-DE"><![CDATA[Fliegend]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="it-IT"><![CDATA[Volare]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[飛行]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[비행]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[Полет]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[Voar]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[飞行]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[飛行]]></LOCALISED_TEXT>
    <INTRINSIC characteristic="CHARACTERISTIC_FLYING" />
  </STATIC_ABILITY>
  <TRIGGERED_ABILITY>
    <LOCALISED_TEXT LanguageCode="en-US"><![CDATA[Whenever a Dragon you control attacks, put a 6/6 red Dragon creature token with flying onto the battlefield.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="fr-FR"><![CDATA[À chaque fois qu’un dragon que vous contrôlez attaque, mettez sur le champ de bataille un jeton de créature 6/6 rouge Dragon avec le vol.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="es-ES"><![CDATA[Siempre que un Dragón que controlas ataque, pon en el campo de batalla una ficha de criatura Dragón roja 6/6 con la habilidad de volar.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="de-DE"><![CDATA[Immer wenn ein Drache angreift, den du kontrollierst, bringe einen 6/6 roten Drache-Kreaturenspielstein mit Flugfähigkeit ins Spiel.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="it-IT"><![CDATA[Ogniqualvolta un Drago che controlli attacca, metti sul campo di battaglia una pedina creatura Drago 6/6 rossa con volare.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[あなたがコントロールするドラゴンが１体攻撃するたび、飛行を持つ赤の６/６のドラゴン・クリーチャー・トークンを１体戦場に出す。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[당신이 조종하는 용이 공격할 때마다, 비행을 가진 6/6 적색 용 생물 토큰 한 개를 전장에 놓는다.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[Каждый раз, когда Дракон под вашим контролем атакует, положите на поле битвы одну фишку существа 6/6 красный Дракон с Полетом.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[Toda vez que um Dragão que você controla atacar, coloque no campo de batalha uma ficha de criatura vermelha 6/6 do tipo Dragão com voar.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[每当一个由你操控的龙攻击时，将一个6/6红色，具飞行异能的龙衍生生物放进战场。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[每當一個由你操控的龍攻擊時，將一個6/6紅色，具飛行異能的龍衍生生物放進戰場。]]></LOCALISED_TEXT>
    <TRIGGER value="ATTACKING" simple_qualifier="objectyoucontrol">
    return TriggerObject():GetSubType():Test(CREATURE_TYPE_DRAGON)
    </TRIGGER>
    <RESOLUTION_TIME_ACTION>
    MTG():PutTokensOntoBattlefield( "TOKEN_DRAGON_6_6_R_F_388100", 1, EffectController() ) 
    </RESOLUTION_TIME_ACTION>
  </TRIGGERED_ABILITY>
