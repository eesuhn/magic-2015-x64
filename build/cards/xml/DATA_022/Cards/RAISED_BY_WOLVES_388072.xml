    <CONTINUOUS_ACTION layer="7C">
    local parent = EffectSource():GetParent()
    if parent ~= nil then
    	local filter = ClearFilter()
    	filter:Add(FE_SUBTYPE, OP_IS, CREATURE_TYPE_WOLF )
    	filter:Add( FE_CONTROLLER, OP_IS, EffectController())
    	local number = filter:Count()
    	parent:GetCurrentCharacteristics():Power_Add( number )
    	parent:GetCurrentCharacteristics():Toughness_Add( number )
    end
    </CONTINUOUS_ACTION>
