    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[懂不懂笑点都该死。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[懂不懂笑點都該死。]]></LOCALISED_TEXT>
