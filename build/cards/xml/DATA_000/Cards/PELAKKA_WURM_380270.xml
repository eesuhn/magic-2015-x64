  <TRIGGERED_ABILITY>
    <LOCALISED_TEXT LanguageCode="en-US"><![CDATA[When Pelakka Wurm enters the battlefield, you gain 7 life.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="fr-FR"><![CDATA[Quand la Guivre de Pelakka arrive sur le champ de bataille, vous gagnez 7 points de vie.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="es-ES"><![CDATA[Cuando la Sierpe de Pelakka entre al campo de batalla, ganas 7 vidas.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="de-DE"><![CDATA[Wenn der Pelakka-Wurm ins Spiel kommt, erhältst du 7 Lebenspunkte dazu.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="it-IT"><![CDATA[Quando il Wurm di Pelakka entra nel campo di battaglia, guadagni 7 punti vita.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[ペラッカのワームが戦場に出たとき、あなたは７点のライフを得る。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[펠라카 웜이 전장에 들어올 때, 당신은 생명 7점을 얻는다.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[Когда Вурм Ущелья Пелакка выходит на поле битвы, вы получаете 7 жизней.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[Quando Vorme de Pelakka entra no campo de batalha, você ganha 7 pontos de vida.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[当皮拉卡亚龙进战场时，你获得7点生命。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[當皮拉卡亞龍進戰場時，你獲得7點生命。]]></LOCALISED_TEXT>
    <TRIGGER value="ZONECHANGE_END" simple_qualifier="self" to_zone="ZONE_BATTLEFIELD" />
    <RESOLUTION_TIME_ACTION>
    EffectController():GainLife(7 )
    </RESOLUTION_TIME_ACTION>
    <AUTO_SKIP>
    local effectController = EffectController()
    if effectController:GetTeam():IsSharedLifeTotal() == true then
    	if effectController:GetLifeTotal() &gt;= 30 then
    		return true
    	end
    else
    	if effectController:GetLifeTotal() &gt;= 20 then
    		return true
    	end
    end	
    return false
    </AUTO_SKIP>
  </TRIGGERED_ABILITY>
  <TRIGGERED_ABILITY>
    <LOCALISED_TEXT LanguageCode="en-US"><![CDATA[When Pelakka Wurm dies, draw a card.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="fr-FR"><![CDATA[Quand la Guivre de Pelakka meurt, piochez une carte.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="es-ES"><![CDATA[Cuando la Sierpe de Pelakka muera, roba una carta.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="de-DE"><![CDATA[Wenn der Pelakka-Wurm stirbt, ziehe eine Karte.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="it-IT"><![CDATA[Quando il Wurm di Pelakka muore, pesca una carta.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[ペラッカのワームが死亡したとき、カードを１枚引く。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[펠라카 웜이 죽을 때, 카드 한 장을 뽑는다.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[Когда Вурм Ущелья Пелакка умирает, возьмите карту.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[Quando Vorme de Pelakka morrer, compre um card.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[当皮拉卡亚龙死去时，抓一张牌。]]></LOCALISED_TEXT>
