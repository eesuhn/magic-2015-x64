    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[Вурм Ущелья Пелакка]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[Vorme de Pelakka]]></LOCALISED_TEXT>
