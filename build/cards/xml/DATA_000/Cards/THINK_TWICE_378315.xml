  <CASTING_COST cost="{1}{U}" />
  <FLAVOURTEXT>
    <LOCALISED_TEXT LanguageCode="en-US"><![CDATA[“Either I know just the spell I need, or I’m about to.”]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="fr-FR"><![CDATA[« Ou je sais déjà de quel sort j'ai besoin, ou je vais le découvrir. »]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="es-ES"><![CDATA[“O bien conozco el hechizo que necesito, o estoy a punto de hacerlo”.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="de-DE"><![CDATA[„Entweder weiß ich den Spruch schon, den ich brauche, oder ich weiß es gleich.“]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="it-IT"><![CDATA[“O conosco proprio la magia che mi serve oppure sto per conoscerla.”]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[「私が必要な呪文は、知ってるか、間もなく知るかだ。」]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA["딱 필요한 주문을 알고 있거나 곧 알게 될 거야."]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[«Либо я уже знаю заклинание, которое мне нужно, либо сейчас узнаю».]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[“Ou eu sei exatamente a magia de que preciso ou estou prestes a saber.”]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[「我不是懂了正好需要的咒语，就是快要懂了。」]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[「我不是懂了正好需要的咒語，就是快要懂了。」]]></LOCALISED_TEXT>
  </FLAVOURTEXT>
