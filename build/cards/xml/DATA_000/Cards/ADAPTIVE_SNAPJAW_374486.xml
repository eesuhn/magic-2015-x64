    <TRIGGER value="ZONECHANGE_END" simple_qualifier="objectyoucontrol" to_zone="ZONE_BATTLEFIELD" from_zone="ZONE_ANY">
    return TriggerObject():GetCardType():Test( CARD_TYPE_CREATURE )
    </TRIGGER>
    <INTERVENING_IF>
    local triggerObject = TriggerObjectLKI()
    local effectSource = EffectSource()
    if triggerObject ~= nil and effectSource ~= nil then
    	local triggerPower = triggerObject:GetCurrentCharacteristics():Power_Get()
    	local triggerToughness = triggerObject:GetCurrentCharacteristics():Toughness_Get()
    	
    	local effectPower = effectSource:GetCurrentCharacteristics():Power_Get()
    	local effectToughness = effectSource:GetCurrentCharacteristics():Toughness_Get()
    	if (triggerPower &gt; effectPower) or (triggerToughness &gt; effectToughness) then
    		return true
    	end
    end
    return false
    </INTERVENING_IF>
    <RESOLUTION_TIME_ACTION>
    if EffectSource() ~= nil then
    	 local numCountersAdded = EffectSource():AddCounters( MTG():PlusOnePlusOneCounters(), 1)
    	 EffectDC():Set_Int(0,numCountersAdded)
    end
    </RESOLUTION_TIME_ACTION>
    <RESOLUTION_TIME_ACTION>
    local countersAdded = EffectDC():Get_Int(0)
    if countersAdded &gt;0 then
    	MTG():FireTrigger( TRIGGER_EVOLVED, EffectSource() )
    end
    </RESOLUTION_TIME_ACTION>
  </TRIGGERED_ABILITY>
