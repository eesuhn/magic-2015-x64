  <TRIGGERED_ABILITY replacement_effect="1" active_zone="ZONE_TRANSITION">
    <LOCALISED_TEXT LanguageCode="en-US"><![CDATA[If Æther Figment was kicked, it enters the battlefield with two +1/+1 counters on it.]]></LOCALISED_TEXT>
