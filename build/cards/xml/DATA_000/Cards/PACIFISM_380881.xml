    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[所結附的生物不能進行攻擊或阻擋。]]></LOCALISED_TEXT>
    <CONTINUOUS_ACTION layer="8">
    local parent = EffectSource():GetParent()
    if parent ~= nil then
    	parent:GetCurrentCharacteristics():Bool_Set( CHARACTERISTIC_CANT_ATTACK, 1 )
    end
    </CONTINUOUS_ACTION>
    <CONTINUOUS_ACTION layer="8">
    local parent = EffectSource():GetParent()
    if parent ~= nil then
    	parent:GetCurrentCharacteristics():Bool_Set( CHARACTERISTIC_CANT_BLOCK, 1 )
    end
    </CONTINUOUS_ACTION>
