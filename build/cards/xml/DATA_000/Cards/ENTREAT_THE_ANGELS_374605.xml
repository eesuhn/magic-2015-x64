    <TRIGGER value="DREW_CARD" simple_qualifier="self">
    local interrogation = MTG():ClearInterrogationQuery()
    interrogation:SetPlayer( EffectController() )
    local num_drawn_this_turn = interrogation:Count( INTERROGATE_CARDS_DRAWN, INTERROGATE_THIS_TURN, 2 )
    if num_drawn_this_turn == 1 then
    	return true
    else
    	return false
    end
    </TRIGGER>
    <RESOLUTION_TIME_ACTION>
    local effectController = EffectController()
    if TriggerObject()~= nil then
    	if effectController:CanCastSpellUsingResourceCost( TriggerObject(), 1 ) then
    		effectController:BeginNewMultipleChoice()   
    		effectController:AddMultipleChoiceAnswer( "CARD_QUERY_ENTREAT_THE_ANGELS_CAST_ENTREAT_THE_ANGELS" )   
    		effectController:AddMultipleChoiceAnswer( "CARD_QUERY_ENTREAT_THE_ANGELS_DO_NOT_CAST_ENTREAT_THE_ANGELS" )   
    		effectController:AskMultipleChoiceQuestion( "CARD_QUERY_ENTREAT_THE_ANGELS_QUESTION", TriggerObject() )
    	end
    end
    </RESOLUTION_TIME_ACTION>
    <RESOLUTION_TIME_ACTION>
    local answer = EffectController():GetMultipleChoiceResult()
    if TriggerObject() ~= nil and EffectController():CanCastSpellUsingResourceCost( TriggerObject(), 1 )then
    	if answer == 0 then
    		EffectController():CastSpellUsingResourceCost( TriggerObject(), 1 )
    	end
    end
    </RESOLUTION_TIME_ACTION>
  </TRIGGERED_ABILITY>
