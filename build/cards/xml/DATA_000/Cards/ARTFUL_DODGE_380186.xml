    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[目標生物本回合不能被阻擋。]]></LOCALISED_TEXT>
    <TARGET tag="CHOOSE_A_CREATURE_THAT_CANT_BE_BLOCKED_THIS_TURN" definition="0" compartment="0" count="1" />
    <TARGET_DEFINITION id="0">
    local filter = ClearFilter()
    filter:Add( FE_TYPE, OP_IS, CARD_TYPE_CREATURE )
    </TARGET_DEFINITION>
    <CONTINUOUS_ACTION layer="8">
    local target = EffectDC():Get_Targets(0):Get_CardPtr(0)
    if target ~= nil then
    	local characteristics = target:GetCurrentCharacteristics()
    	characteristics:Bool_Set( CHARACTERISTIC_UNBLOCKABLE, 1 )
    end 
    </CONTINUOUS_ACTION>
    <DURATION simple_duration="UntilEOT" />
    <AI_SIMPLIFIED_TARGETING compartment="0" hint="HINT_ALLIED_ONLY" />
