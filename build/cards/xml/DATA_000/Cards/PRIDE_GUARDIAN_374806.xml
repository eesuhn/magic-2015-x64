  <TRIGGERED_ABILITY>
    <LOCALISED_TEXT LanguageCode="en-US"><![CDATA[Whenever Pride Guardian blocks, you gain 3 life.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="fr-FR"><![CDATA[À chaque fois que le Gardien de la bande bloque, vous gagnez 3 points de vie.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="es-ES"><![CDATA[Siempre que el Guardián de la manada bloquee, ganas 3 vidas.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="de-DE"><![CDATA[Immer wenn die Rudelwache blockt, erhältst du 3 Lebenspunkte dazu.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="it-IT"><![CDATA[Ogniqualvolta il Guardiano del Branco blocca, guadagni 3 punti vita.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[群れの護衛がブロックするたび、あなたは３点のライフを得る。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[무리 수호자가 방어할 때마다, 당신은 생명 3점을 얻는다.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[Каждый раз, когда Страж Прайда блокирует, вы получаете 3 жизни.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[Toda vez que Guardião do Bando bloqueia, você ganha 3 pontos de vida.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[每当狮群守护者阻挡时，你获得3点生命。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[每當獅群守護者阻擋時，你獲得3點生命。]]></LOCALISED_TEXT>
    <TRIGGER value="BLOCKING" simple_qualifier="self" to_zone="ZONE_ANY" from_zone="ZONE_ANY" />
    <RESOLUTION_TIME_ACTION>
    EffectController():GainLife(3 )
    </RESOLUTION_TIME_ACTION>
  </TRIGGERED_ABILITY>
