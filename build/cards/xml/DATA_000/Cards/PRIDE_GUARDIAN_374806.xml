  <FLAVOURTEXT>
    <LOCALISED_TEXT LanguageCode="en-US"><![CDATA[“Any hotheaded cub can raise a sword in anger.”]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="fr-FR"><![CDATA[« N'importe quel lionceau en colère peut brandir une épée. »]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="es-ES"><![CDATA[“Cualquier cachorro impulsivo puede esgrimir una espada con ira”.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="de-DE"><![CDATA[„Wütend mit seinem Schwert herumfuchteln kann jedes Jungtier.“]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="it-IT"><![CDATA[“Qualsiasi cucciolo irruento può levare una spada per la rabbia.”]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[「短気な幼子でも、怒りに剣を持ち上げることぐらいできるさ。」]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA["성질 급한 어린 녀석들이나 분노에 휩싸여 칼을 휘두르지."]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[«Любой вспыльчивый молокосос может в гневе поднять меч».]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[“Qualquer filhote brigão pode empunhar uma espada num ataque de ira.”]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[「每个热血冲昏头的小子都能仗愤使剑。」]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[「每個熱血衝昏頭的小子都能仗憤使劍。」]]></LOCALISED_TEXT>
  </FLAVOURTEXT>
