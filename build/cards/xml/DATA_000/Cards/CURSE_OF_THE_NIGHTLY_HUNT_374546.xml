  <TITLE>
    <LOCALISED_TEXT LanguageCode="en-US"><![CDATA[Curse of the Nightly Hunt]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="fr-FR"><![CDATA[Malédiction de la chasse nocturne]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="es-ES"><![CDATA[Maldición de la cacería nocturna]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="de-DE"><![CDATA[Fluch der nächtlichen Jagd]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="it-IT"><![CDATA[Maledizione della Caccia Notturna]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[夜（よ）毎（ごと）の狩（か）りの呪（のろ）い]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[밤 사냥의 저주]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[Проклятие Еженощной Охоты]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[Maldição da Caçada Noturna]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[每夜行猎诅咒]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[每夜行獵詛咒]]></LOCALISED_TEXT>
  </TITLE>
  <MULTIVERSEID value="374546" />
