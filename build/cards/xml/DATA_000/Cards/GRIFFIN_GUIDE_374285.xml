    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[所結附的生物得+2/+2且具有飛行異能。]]></LOCALISED_TEXT>
    <CONTINUOUS_ACTION layer="7C">
    if EffectSource()~= nil then
    	local parent = EffectSource():GetParent()
    	if parent ~= nil then
    		parent:GetCurrentCharacteristics():Power_Add( 2 )
    		parent:GetCurrentCharacteristics():Toughness_Add( 2 )
    	end
    end
    </CONTINUOUS_ACTION>
    <CONTINUOUS_ACTION layer="6">
    local parent = EffectSource():GetParent()
    if parent ~= nil then
    	parent:GetCurrentCharacteristics():Bool_Set( CHARACTERISTIC_FLYING, 1 )
    end
    </CONTINUOUS_ACTION>
