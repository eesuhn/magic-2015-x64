    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[盲目食尸鬼不能进行阻挡。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[盲目食屍鬼不能進行阻擋。]]></LOCALISED_TEXT>
    <CONTINUOUS_ACTION layer="8">
    if EffectSource() ~= nil then
    local characteristics = EffectSource():GetCurrentCharacteristics()
