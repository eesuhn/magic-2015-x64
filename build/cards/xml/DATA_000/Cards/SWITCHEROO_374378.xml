    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[생물 두 개를 목표로 정한다. 두 생물의 조종권을 교환한다.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[Поменяйтесь контролем над двумя целевыми существами.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[Permute o controle de duas criaturas alvo.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[交换两个目标生物的操控权。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[交換兩個目標生物的操控權。]]></LOCALISED_TEXT>
    <SFX text="TARGET_PLASMA_PLAY" />
    <TARGET tag="CARD_QUERY_CHOOSE_CREATURE_TO_EXCHANGE" definition="0" compartment="0" count="2" />
    <TARGET_DEFINITION id="0">
    local filter = ClearFilter()
    filter:Add( FE_TYPE, OP_IS, CARD_TYPE_CREATURE )
    </TARGET_DEFINITION>
    <RESOLUTION_TIME_ACTION>
    if EffectDC():Get_Targets(0):Get_CardPtr(0) ~= nil and EffectDC():Get_Targets(0):Get_CardPtr(1) ~= nil then
    	EffectDC():Set_PlayerPtr(1, EffectDC():Get_Targets(0):Get_CardPtr(0):GetPlayer() )
    	EffectDC():Set_PlayerPtr(2, EffectDC():Get_Targets(0):Get_CardPtr(1):GetPlayer() )
    end
    </RESOLUTION_TIME_ACTION>
    <CONTINUOUS_ACTION layer="2">
    local targetA = EffectDC():Get_Targets(0):Get_CardPtr(0)
    local targetB = EffectDC():Get_Targets(0):Get_CardPtr(1)
    local destinationPlayerForTargetA = EffectDC():Get_PlayerPtr(2)
    local destinationPlayerForTargetB = EffectDC():Get_PlayerPtr(1)
    if targetA ~= nil and destinationPlayerForTargetA ~= nil then
    	targetA:SetController(destinationPlayerForTargetA)
    end
    if targetB ~= nil and destinationPlayerForTargetB ~= nil then
    	targetB:SetController(destinationPlayerForTargetB)
    end
    </CONTINUOUS_ACTION>
    <DURATION>
    return (EffectDC():Get_Targets(0):Get_CardPtr(0) == nil) and (EffectDC():Get_Targets(0):Get_CardPtr(1) == nil)
    </DURATION>
  </SPELL_ABILITY>
