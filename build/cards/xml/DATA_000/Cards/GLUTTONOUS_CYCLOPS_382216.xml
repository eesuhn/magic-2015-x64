    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[Прожорливый Циклоп]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[Ciclope Glutão]]></LOCALISED_TEXT>
