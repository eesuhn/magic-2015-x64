  <FLAVOURTEXT>
    <LOCALISED_TEXT LanguageCode="en-US"><![CDATA[“Words lie. People lie. The land tells the truth.”]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="fr-FR"><![CDATA[« Les mondes sont mensonges. Les gens sont mensonges. La terre est vérité. »]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="es-ES"><![CDATA[“Las palabras mienten. La gente miente. La tierra dice la verdad”.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="de-DE"><![CDATA[„Worte lügen. Leute lügen. Nur das Land sagt die Wahrheit.“]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="it-IT"><![CDATA[“Le parole mentono. Le persone mentono. La terra dice sempre la verità.”]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[「言葉は嘘をつく。人々も嘘をつく。大地は真実を告げてくれる。」]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA["단어는 거짓을 전한다. 사람은 거짓을 전한다. 대지만이 진실을 전한다."]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[«Слова лгут. Люди лгут. Земля же говорит правду».]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[“Palavras mentem. Pessoas mentem. A terra diz a verdade.”]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[「言能欺人。人能欺世。唯大地揭示真理。」]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[「言能欺人。人能欺世。唯大地揭示真理。」]]></LOCALISED_TEXT>
  </FLAVOURTEXT>
