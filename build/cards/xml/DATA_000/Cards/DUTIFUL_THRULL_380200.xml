    <LOCALISED_TEXT LanguageCode="it-IT"><![CDATA[Thrull Obbediente]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[従（じゅう）順（じゅん）なスラル]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[순종적인 스럴]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[Покорный Трулл]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[Thrull Obediente]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[尽忠索尔兽]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[盡忠索爾獸]]></LOCALISED_TEXT>
  </TITLE>
  <MULTIVERSEID value="380200" />
