    <SFX text="EXTORT_PLAY" />
    <TRIGGER value="SPELL_PLAYED" simple_qualifier="objectyoucontrol" />
    <RESOLUTION_TIME_ACTION>
    EffectSourceLKI():AllowSFX(false)
    local effectController = EffectController()
    if effectController ~= nil then
    	if effectController:CanPayManaCost("{W/B}") then
    		effectController:BeginNewMultipleChoice()   
    		effectController:AddMultipleChoiceAnswer( "CARD_QUERY_ANSWER_EXTORT_PAY_WB" )   
    		effectController:AddMultipleChoiceAnswer( "CARD_QUERY_EXTORY_DO_NOT_PAY_WB" )   
    		effectController:AskMultipleChoiceQuestion( "CARD_QUERY_EXTORT_QUESTION", TriggerObject() )
    	end
    end
    </RESOLUTION_TIME_ACTION>
    <RESOLUTION_TIME_ACTION>
    local effectController = EffectController()
    if effectController:CanPayManaCost("{W/B}") then
    	local queryResult = effectController:GetMultipleChoiceResult()
    	
    	if queryResult == 0 then
    		
    		effectController:PayManaCost("{W/B}")
    		local numPlayers = MTG():GetNumberOfPlayers()
    		local lifeToGain = 0
    		
    		for i = 0, (numPlayers-1) do
    			local currentPlayer = MTG():GetNthPlayer(i)
    			if currentPlayer ~= nil and currentPlayer:GetTeam() ~= effectController:GetTeam() then
    				local lifeLost = currentPlayer:LoseLife(1)
    				lifeToGain = lifeToGain+lifeLost
    			end
    		end
    		effectController:GainLife(lifeToGain)
    		EffectSourceLKI():AllowSFX(true)
    	end
    end
    </RESOLUTION_TIME_ACTION>
  </TRIGGERED_ABILITY>
