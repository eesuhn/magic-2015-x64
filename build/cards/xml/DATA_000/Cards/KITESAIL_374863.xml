    <LOCALISED_TEXT LanguageCode="de-DE"><![CDATA[Die ausgerüstete Kreatur erhält +1/+0 und hat Flugfähigkeit.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="it-IT"><![CDATA[La creatura equipaggiata prende +1/+0 e ha volare.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[装備しているクリーチャーは＋１/＋０の修整を受けるとともに飛行を持つ。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[장착된 생물은 +1/+0을 받고 비행을 가진다.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[Снаряженное существо получает +1/+0 и имеет Полет.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[A criatura equipada recebe +1/+0 e tem voar.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[佩带此武具的生物得+1/+0且具有飞行异能。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[佩帶此武具的生物得+1/+0且具飛行異能。]]></LOCALISED_TEXT>
    <CONTINUOUS_ACTION layer="7C">
    if EffectSource()~= nil then
    	local parent = EffectSource():GetParent()
    	if parent ~= nil then
    		parent:GetCurrentCharacteristics():Power_Add( 1 )
    		parent:GetCurrentCharacteristics():Toughness_Add( 0 )
    	end
    end
    </CONTINUOUS_ACTION>
    <CONTINUOUS_ACTION layer="6">
    local parent = EffectSource():GetParent()
    if parent ~= nil then
    	parent:GetCurrentCharacteristics():Bool_Set( CHARACTERISTIC_FLYING, 1 )
    end
    </CONTINUOUS_ACTION>
  </STATIC_ABILITY>
