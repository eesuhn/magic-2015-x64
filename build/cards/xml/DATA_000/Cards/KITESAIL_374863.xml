    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[연글라이더]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[Кайтсейл]]></LOCALISED_TEXT>
