    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[Toda vez que a criatura equipada sofrer dano, destrua-a.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[每当佩带此武具的生物受到伤害时，消灭该生物。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[每當佩帶此武具的生物受到傷害時，消滅該生物。]]></LOCALISED_TEXT>
    <TRIGGER value="OBJECT_TAKES_DAMAGE" damage_type="all">
    if EffectSource() ~= nil then
    	return TriggerObject() == EffectSource():GetParent()
    end
    </TRIGGER>
    <RESOLUTION_TIME_ACTION>
    if EffectSource() ~= nil then
    	local parent = EffectSource():GetParent() 
    	if parent ~= nil then
    		parent:Destroy()  
    	end
    end
    </RESOLUTION_TIME_ACTION>
  </TRIGGERED_ABILITY>
