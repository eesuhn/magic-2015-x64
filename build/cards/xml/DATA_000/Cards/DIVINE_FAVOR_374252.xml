  <TRIGGERED_ABILITY>
    <LOCALISED_TEXT LanguageCode="en-US"><![CDATA[When Divine Favor enters the battlefield, you gain 3 life.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="fr-FR"><![CDATA[Quand la Faveur divine arrive sur le champ de bataille, vous gagnez 3 points de vie.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="es-ES"><![CDATA[Cuando el Favor divino entre al campo de batalla, ganas 3 vidas.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="de-DE"><![CDATA[Wenn die Göttliche Gunst ins Spiel kommt, erhältst du 3 Lebenspunkte dazu.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="it-IT"><![CDATA[Quando la Benevolenza Divina entra nel campo di battaglia, guadagni 3 punti vita.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[神聖なる好意が戦場に出たとき、あなたは３点のライフを得る。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[신의 은혜가 전장에 들어올 때, 당신은 생명 3점을 얻는다.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[Когда Божественное Покровительство выходит на поле битвы, вы получаете 3 жизни.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[Quando Proteção Divina entra no campo de batalha, você ganha 3 pontos de vida.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[当上天眷顾进战场时，你获得3点生命。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[當上天眷顧進戰場時，你獲得3點生命。]]></LOCALISED_TEXT>
    <TRIGGER value="ZONECHANGE_END" simple_qualifier="self" to_zone="ZONE_BATTLEFIELD" />
    <RESOLUTION_TIME_ACTION>
    EffectController():GainLife(3 )
    </RESOLUTION_TIME_ACTION>
    <AUTO_SKIP>
    local effectController = EffectController()
    if effectController:GetTeam():IsSharedLifeTotal() == true then
    	if effectController:GetLifeTotal() &gt;= 30 then
    		return true
    	end
    else
    	if effectController:GetLifeTotal() &gt;= 20 then
    		return true
    	end
    end	
    return false
    </AUTO_SKIP>
  </TRIGGERED_ABILITY>
