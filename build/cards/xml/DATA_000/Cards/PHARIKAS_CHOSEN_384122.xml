    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[ファリカに選（えら）ばれしもの]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[파리카의 정예병]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[Избранница Фарики]]></LOCALISED_TEXT>
