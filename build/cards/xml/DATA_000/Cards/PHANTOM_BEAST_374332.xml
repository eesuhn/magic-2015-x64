  <CARDNAME text="PHANTOM_BEAST" />
  <TITLE>
    <LOCALISED_TEXT LanguageCode="en-US"><![CDATA[Phantom Beast]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="fr-FR"><![CDATA[Bête fantomatique]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="es-ES"><![CDATA[Bestia fantasmal]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="de-DE"><![CDATA[Phantombestie]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="it-IT"><![CDATA[Bestia Fantasma]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[幻（げん）影（えい）の獣（けもの）]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[허깨비 야수]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[Призрачный Зверь]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[Fera Fantasma]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[幽魅兽]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[幽魅獸]]></LOCALISED_TEXT>
  </TITLE>
  <MULTIVERSEID value="374332" />
  <ARTID value="129107" />
  <ARTIST name="Ryan Yee" />
  <CASTING_COST cost="{3}{U}" />
  <FLAVOURTEXT>
    <LOCALISED_TEXT LanguageCode="en-US"><![CDATA[As insubstantial as fear, and as dangerous.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="fr-FR"><![CDATA[Tout aussi immatérielle que la peur, et tout aussi dangereuse.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="es-ES"><![CDATA[Etéreo como el miedo, e igual de peligroso.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="de-DE"><![CDATA[So wenig greifbar wie Furcht und genauso gefährlich.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="it-IT"><![CDATA[Incorporea come la paura e altrettanto pericolosa.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[実態の無さは恐怖に似ている。そして危険なところも。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[공포처럼 실체가 없으나 공포 만큼이나 위험하다.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[Иллюзорный, как страх, и такой же опасный.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[Tão insubstancial quanto o medo, e tão perigoso quanto.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[无形且危险，一如恐惧。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[無形且危險，一如恐懼。]]></LOCALISED_TEXT>
  </FLAVOURTEXT>
  <TYPE metaname="Creature" />
  <SUB_TYPE metaname="Illusion" />
  <SUB_TYPE metaname="Beast" />
  <EXPANSION value="DPI" />
  <RARITY metaname="C" />
  <POWER value="4" />
  <TOUGHNESS value="5" />
  <TRIGGERED_ABILITY>
    <LOCALISED_TEXT LanguageCode="en-US"><![CDATA[When Phantom Beast becomes the target of a spell or ability, sacrifice it.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="fr-FR"><![CDATA[Quand la Bête fantomatique devient la cible d’un sort ou d’une capacité, sacrifiez-la.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="es-ES"><![CDATA[Cuando la Bestia fantasmal sea objetivo de un hechizo o habilidad, sacrifícala.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="de-DE"><![CDATA[Wenn die Phantombestie das Ziel eines Zauberspruchs oder einer Fähigkeit wird, opfere sie.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="it-IT"><![CDATA[Quando la Bestia Fantasma diventa bersaglio di una magia o abilità, sacrificala.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[幻影の獣が呪文や能力の対象になったとき、これを生け贄に捧げる。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[허깨비 야수가 주문이나 능력의 목표가 될 때, 허깨비 야수를 희생한다.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[Когда Призрачный Зверь становится целью заклинания или способности, пожертвуйте его.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[Quando Fera Fantasma se tornar alvo de uma mágica ou habilidade, sacrifique-a.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[当幽魅兽成为咒语或异能的目标时，将它牺牲。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[當幽魅獸成為咒語或異能的目標時，將它犧牲。]]></LOCALISED_TEXT>
    <TRIGGER value="BECAME_TARGET_OF_SPELL" simple_qualifier="self" />
    <TRIGGER value="BECAME_TARGET_OF_ABILITY" simple_qualifier="self" />
    <RESOLUTION_TIME_ACTION>
    if EffectSource() ~= nil then
    	EffectController():Sacrifice( EffectSource() )
    end
    </RESOLUTION_TIME_ACTION>
  </TRIGGERED_ABILITY>
