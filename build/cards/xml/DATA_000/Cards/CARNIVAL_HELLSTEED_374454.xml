    <RESOLUTION_TIME_ACTION>
    local effectController = EffectController()
    effectController:BeginNewMultipleChoice()   
    effectController:AddMultipleChoiceAnswer( "CARD_QUERY_UNLEASH" )   
    effectController:AddMultipleChoiceAnswer( "CARD_QUERY_DO_NOT_UNLEASH" )   
    effectController:AskMultipleChoiceQuestion( "CARD_QUERY_QUESTION_DO_YOU_WANT_TO_UNLEASH", TriggerObject() )
