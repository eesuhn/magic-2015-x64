    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[闇（やみ）の追（お）い返（かえ）し]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[어둠 몰아내기]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[Отразить Тьму]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[Repelir a Escuridão]]></LOCALISED_TEXT>
