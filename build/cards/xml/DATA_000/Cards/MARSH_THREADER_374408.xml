    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[Болотный Канатолаз]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[Atravessador de Palude]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[绳索渡沼人]]></LOCALISED_TEXT>
