    <LOCALISED_TEXT LanguageCode="en-US"><![CDATA[Sacrifice Death Cultist: Target player loses 1 life and you gain 1 life.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="fr-FR"><![CDATA[Sacrifiez le Cultiste de la mort : Le joueur ciblé perd 1 point de vie et vous gagnez 1 point de vie.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="es-ES"><![CDATA[Sacrificar el Cultista de la muerte: El jugador objetivo pierde 1 vida y tú ganas 1 vida.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="de-DE"><![CDATA[Opfere den Todeskultisten: Ein Spieler deiner Wahl verliert 1 Lebenspunkt, und du erhältst 1 Lebenspunkt dazu.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="it-IT"><![CDATA[Sacrifica il Cultista della Morte: Un giocatore bersaglio perde 1 punto vita e tu guadagni 1 punto vita.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[死の信者を生け贄に捧げる：プレイヤー１人を対象とする。そのプレイヤーは１点のライフを失い、あなたは１点のライフを得る。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[죽음의 광신도를 희생한다: 플레이어 한 명을 목표로 정한다. 그 플레이어는 생명 1점을 잃고 당신은 생명 1점을 얻는다.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[Пожертвуйте Последователя Культа Смерти: целевой игрок теряет 1 жизнь, а вы получаете 1 жизнь.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[Sacrifique Cultista da Morte: O jogador alvo perde 1 ponto de vida e você ganha 1 ponto de vida.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[牺牲死亡教众：目标牌手失去1点生命且你获得1点生命。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[犧牲死亡教眾：目標玩家失去1點生命且你獲得1點生命。]]></LOCALISED_TEXT>
    <COST type="SacrificeSelf" />
    <TARGET tag="CARD_QUERY_CHOOSE_PLAYER_LOSE_1" definition="0" compartment="0" count="1" />
    <TARGET_DEFINITION id="0">
    local filter = ClearFilter()
    filter:SetFilterType( FILTER_TYPE_PLAYERS )
    </TARGET_DEFINITION>
    <RESOLUTION_TIME_ACTION>
    local target_player = EffectDC():Get_Targets(0):Get_PlayerPtr(0)
    if ( target_player ~= nil ) then   
    	target_player:LoseLife( 1 )
    	EffectController():GainLife(1 )
    end
    </RESOLUTION_TIME_ACTION>
