  <STATIC_ABILITY replacement_effect="1">
    <LOCALISED_TEXT LanguageCode="en-US"><![CDATA[Prevent all combat damage that would be dealt to Guard Gomazoa.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="fr-FR"><![CDATA[Prévenez toutes les blessures de combat qui devraient être infligées au Garde gomazoaire.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="es-ES"><![CDATA[Prevén todo el daño de combate que se le fuera a hacer a la Gomazoa guardiana.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="de-DE"><![CDATA[Verhindere allen Kampfschaden, der dem Gomazoa-Wachposten zugefügt würde.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="it-IT"><![CDATA[Previeni tutto il danno da combattimento che verrebbe inflitto alla Gomazoa di Guardia.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[護衛のゴーマゾアに与えられるすべての戦闘ダメージを軽減する。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[경비 고마조아가 입으려고 하는 모든 전투 피해를 방지한다.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[Предотвратите все боевые повреждения, которые должны быть нанесены Сторожевому Гомазоа.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[Previna todo o dano de combate que seria causado a Gomazoa de Guarda.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[防止将对卫士格玛佐雅造成之所有所有战斗伤害。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[防止將對衛士格瑪佐雅造成之所有戰鬥傷害。]]></LOCALISED_TEXT>
    <CONTINUOUS_ACTION layer="8">
    if EffectSource() ~= nil then
    local characteristics = EffectSource():GetCurrentCharacteristics()
    	characteristics:Bool_Set( CHARACTERISTIC_DOESNT_RECEIVE_COMBAT_DAMAGE, 1 )
    end
    </CONTINUOUS_ACTION>
    <DURATION>
    return (EffectSource() == nil)
    </DURATION>
  </STATIC_ABILITY>
