    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[護（ご）衛（えい）のゴーマゾア]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[경비 고마조아]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[Сторожевой Гомазоа]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[Gomazoa de Guarda]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[卫士格玛佐雅]]></LOCALISED_TEXT>
