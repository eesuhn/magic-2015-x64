  <FLAVOURTEXT>
    <LOCALISED_TEXT LanguageCode="en-US"><![CDATA[“The Wojek defend the laws. We defend the people.”]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="fr-FR"><![CDATA[« Les Wojek défendent les lois. Nous défendons le peuple. »]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="es-ES"><![CDATA[“Los wojek defienden las leyes. Nosotros defendemos a la gente.”]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="de-DE"><![CDATA[„Die Wojek verteidigen die Gesetze. Wir verteidigen die Leute.“]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="it-IT"><![CDATA[“I Wojek difendono la legge. Noi difendiamo la gente.”]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[「ウォジェクが守るのは法だ。我々が守るのは人々だ。」]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[“워젝들은 법을 수호하고, 우리는 사람들을 지킨다.”]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[«Войеки защищают законы. Мы защищаем людей».]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[“Os Wojek defendem as leis. Nós defendemos as pessoas.”]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[「沃耶克保卫律法；我们则保卫人民。」]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[「沃耶克保衛律法；我們則保衛人民。」]]></LOCALISED_TEXT>
  </FLAVOURTEXT>
