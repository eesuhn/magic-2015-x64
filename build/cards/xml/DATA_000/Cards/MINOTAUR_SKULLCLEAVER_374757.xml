  <TRIGGERED_ABILITY>
    <LOCALISED_TEXT LanguageCode="en-US"><![CDATA[When Minotaur Skullcleaver enters the battlefield, it gets +2/+0 until end of turn.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="fr-FR"><![CDATA[Quand le Minotaure brisecrâne arrive sur le champ de bataille, il gagne +2/+0 jusqu’à la fin du tour.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="es-ES"><![CDATA[Cuando el Minotauro destrozacráneos entre al campo de batalla, obtiene +2/+0 hasta el final del turno.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="de-DE"><![CDATA[Wenn der Schädelspalter-Minotaurus ins Spiel kommt, erhält er +2/+0 bis zum Ende des Zuges.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="it-IT"><![CDATA[Quando il Minotauro Fendicranio entra nel campo di battaglia, prende +2/+0 fino alla fine del turno.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[ミノタウルスの頭蓋断ちが戦場に出たとき、これはターン終了時まで＋２/＋０の修整を受ける。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[해골을 가르는 미노타우로스가 전장에 들어올 때, 해골을 가르는 미노타우로스는 턴종료까지 +2/+0을 받는다.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[Когда Минотавр-Череполом выходит на поле битвы, он получает +2/+0 до конца хода.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[Quando Minotauro Rompe-crânios entra no campo de batalha, ele recebe +2/+0 até o final do turno.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[当剖颅牛头怪进战场时，它得+2/+0直到回合结束。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[當剖顱牛頭怪進戰場時，它得+2/+0直到回合結束。]]></LOCALISED_TEXT>
    <TRIGGER value="ZONECHANGE_END" simple_qualifier="self" to_zone="ZONE_BATTLEFIELD" />
    <CONTINUOUS_ACTION layer="7C">
    if EffectSource() ~= nil then
    	local characteristics = EffectSource():GetCurrentCharacteristics()
    	characteristics:Power_Add( 2 )
    	characteristics:Toughness_Add( 0 )
    end 
    </CONTINUOUS_ACTION>
    <DURATION simple_duration="UntilEOT" />
