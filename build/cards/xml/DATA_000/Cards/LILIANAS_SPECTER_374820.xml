  <TRIGGERED_ABILITY>
    <LOCALISED_TEXT LanguageCode="en-US"><![CDATA[When Liliana’s Specter enters the battlefield, each opponent discards a card.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="fr-FR"><![CDATA[Quand le Spectre de Liliana arrive sur le champ de bataille, chaque adversaire se défausse d’une carte.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="es-ES"><![CDATA[Cuando el Espectro de Liliana entre al campo de batalla, cada oponente descarta una carta.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="de-DE"><![CDATA[Wenn Lilianas Specter ins Spiel kommt, wirft jeder Gegner eine Karte ab.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="it-IT"><![CDATA[Quando lo Spettro di Liliana entra nel campo di battaglia, ogni avversario scarta una carta.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[リリアナの死霊が戦場に出たとき、各対戦相手はそれぞれカードを１枚捨てる。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[릴리아나의 스펙터가 전장에 들어올 때, 각 상대는 카드 한 장을 버린다.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[Когда Призрак Лилианы выходит на поле битвы, каждый оппонент сбрасывает карту.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[Quando Espectro de Liliana entra no campo de batalha, cada oponente descarta um card.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[当莉莲娜仆幽灵进战场时，每位对手各弃一张牌。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[當莉蓮娜僕幽靈進戰場時，每位對手各棄一張牌。]]></LOCALISED_TEXT>
    <TRIGGER value="ZONECHANGE_END" simple_qualifier="self" to_zone="ZONE_BATTLEFIELD" />
    <RESOLUTION_TIME_ACTION repeating="1">
    local n = MTG():GetActionRepCount()
    local num_Players = MTG():GetNumberOfPlayers()
    if (n &lt; num_Players) then
    	local player = MTG():GetNthPlayer(n)
    	if player ~= nil then
    		if (player:GetTeam() ~= EffectController():GetTeam()) then
    			local filter = ClearFilter()
    			filter:SetZone( ZONE_HAND, player )
    			player:ChooseItem( "CARD_QUERY_CHOOSE_CARD_TO_DISCARD", EffectDC():Make_Targets(n) )
    		end
    	end
    	return true
    else 
    	for i = 0, (num_Players-1) do
    		local player = MTG():GetNthPlayer(i)
    		if player ~= nil then
    			if (player:GetTeam() ~= EffectController():GetTeam()) then
    				local cardToDiscard = EffectDC():Get_Targets(i):Get_CardPtr(0)
    				if cardToDiscard ~= nil then
    					cardToDiscard:Discard()
    				end
    			end
    		end
    	end
    	return false
    end
    </RESOLUTION_TIME_ACTION>
  </TRIGGERED_ABILITY>
