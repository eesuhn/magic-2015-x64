  <CASTING_COST cost="{4}{B}" />
  <FLAVOURTEXT>
    <LOCALISED_TEXT LanguageCode="en-US"><![CDATA[“My favorite guilty pleasure? Are there innocent ones?”]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="fr-FR"><![CDATA[« Mon péché mignon ? En existe-t-il qui ne le soient pas ? »]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="es-ES"><![CDATA[“¿Mi placer culpable favorito? ¿Acaso los hay inocentes?”.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="de-DE"><![CDATA[„Ob ich ein heimliches Laster habe? Manche würden es als unheimlich bezeichnen.“]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="it-IT"><![CDATA[“Qual è il mio piacere proibito? Perché, esistono forse piaceri leciti?”]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[「私が最も好む背徳的な快楽とは何か、と？後ろめたさのない快楽など、存在するのかね？」]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA["내가 제일 좋아하는 악행? 선한 흡혈귀가 있어?"]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[«Мое любимое грешное удовольствие? А что, удовольствия бывают невинными?»]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[“Meu prazer culposo favorito? Por acaso, existem prazeres inocentes?”]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[「我最爱的罪恶快感？还有无辜的家伙吗？」]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[「我最愛的罪惡快感？這東西哪有純真可言？」]]></LOCALISED_TEXT>
  </FLAVOURTEXT>
