  <TRIGGERED_ABILITY>
    <LOCALISED_TEXT LanguageCode="en-US"><![CDATA[When Arbor Colossus becomes monstrous, destroy target creature with flying an opponent controls.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="fr-FR"><![CDATA[Quand le Colosse arboricole devient monstrueux, détruisez une créature avec le vol ciblée qu’un adversaire contrôle.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="es-ES"><![CDATA[Cuando el Coloso enramado se convierte en monstruoso, destruye la criatura objetivo con la habilidad de volar que controla un oponente.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="de-DE"><![CDATA[Wenn der Laubwald-Koloss monströs wird, zerstöre eine fliegende Kreatur deiner Wahl, die ein Gegner kontrolliert.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="it-IT"><![CDATA[Quando il Colosso degli Alberi diventa mostruoso, distruggi una creatura bersaglio con volare controllata da un avversario.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[高木の巨人が怪物的になったとき、対戦相手がコントロールする飛行を持つクリーチャー１体を対象とし、それを破壊する。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[수목 거상이 괴수화할 때, 상대가 조종하는 생물 중 비행을 가진 생물 한 개를 목표로 정한다. 그 생물을 파괴한다.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[Когда Лесной Колосс становится чудовищным, уничтожьте целевое существо с Полетом под контролем оппонента.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[Quando Colosso do Arvoredo se tornar monstruoso, destrua a criatura alvo com voar que um oponente controla.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[当乔木巨像蛮化时，消灭目标由对手操控且具飞行异能的生物。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[當喬木巨像蠻化時，消滅目標由對手操控且具飛行異能的生物。]]></LOCALISED_TEXT>
    <TRIGGER value="BECAME_MONSTROUS" simple_qualifier="self" />
    <TARGET tag="CARD_QUERY_CHOOSE_CREATURE_TO_DESTROY" definition="0" compartment="0" count="1" />
    <TARGET_DEFINITION id="0">
    local filter = ClearFilter()
    filter:Add( FE_TYPE, OP_IS, CARD_TYPE_CREATURE )
    filter:Add( FE_CHARACTERISTIC, OP_HAS, CHARACTERISTIC_FLYING )
    filter:Add( FE_TEAM, OP_NOT, EffectController():GetTeam())
    </TARGET_DEFINITION>
    <RESOLUTION_TIME_ACTION>
    local target = EffectDC():Get_Targets(0):Get_CardPtr(0)
    if target ~= nil then   
    	target:Destroy(EffectSource())  
    end
    </RESOLUTION_TIME_ACTION>
    <AVAILABILITY>
    return Object():IsMonstrous() == false 
    </AVAILABILITY>
  </TRIGGERED_ABILITY>
