    <LOCALISED_TEXT LanguageCode="it-IT"><![CDATA[Demone del Cancello di Morte]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[死（し）の門（もん）の悪（あく）魔（ま）]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[죽음문의 악마]]></LOCALISED_TEXT>
