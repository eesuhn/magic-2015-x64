  <STATIC_ABILITY>
    <LOCALISED_TEXT LanguageCode="en-US"><![CDATA[Deathbellow Raider attacks each turn if able.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="fr-FR"><![CDATA[Le Pillard beuglemort attaque à chaque tour si possible.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="es-ES"><![CDATA[El Incursor rugidomortal ataca cada turno si puede.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="de-DE"><![CDATA[Der Todessenken-Plünderer greift in jedem Zug an, falls möglich.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="it-IT"><![CDATA[Il Razziatore del Muggito di Morte attacca ogni turno, se può farlo.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[死呻きの略奪者は可能なら毎ターン攻撃する。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[죽음골짜기 약탈자는 가능하면 매 턴마다 공격한다.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[Налетчик из Глотки Смерти атакует в каждом ходу, если может.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[Salteador do Urro Mortal ataca a cada turno se estiver apto.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[亡啸谷突击兵每回合若能攻击，则必须攻击。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[亡嘯谷突擊兵每回合若能攻擊，則必須攻擊。]]></LOCALISED_TEXT>
    <CONTINUOUS_ACTION layer="8">
    if EffectSource() ~= nil then
    local characteristics = EffectSource():GetCurrentCharacteristics()
    	characteristics:Bool_Set( CHARACTERISTIC_MUST_ATTACK_EACH_TURN, 1 )
    end
    </CONTINUOUS_ACTION>
  </STATIC_ABILITY>
