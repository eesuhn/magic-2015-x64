    <LOCALISED_TEXT LanguageCode="en-US"><![CDATA[Each player puts the top five cards of his or her library into his or her graveyard.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="fr-FR"><![CDATA[Chaque joueur met les cinq cartes du dessus de sa bibliothèque dans son cimetière.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="es-ES"><![CDATA[Cada jugador pone las cinco primeras cartas de su biblioteca en su cementerio.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="de-DE"><![CDATA[Jeder Spieler legt die obersten fünf Karten seiner Bibliothek auf seinen Friedhof.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="it-IT"><![CDATA[Ogni giocatore mette nel proprio cimitero le prime cinque carte del proprio grimorio.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[各プレイヤーは、それぞれ自分のライブラリーの一番上から５枚のカードを自分の墓地に置く。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[각 플레이어는 자신의 서고 맨 위의 카드 다섯 장을 자신의 무덤에 넣는다.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[Каждый игрок кладет пять верхних карт своей библиотеки на свое кладбище.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[Cada jogador coloca os cinco cards do topo do próprio grimório no próprio cemitério.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[每位牌手各将其牌库顶的五张牌置入其坟墓场。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[每個玩家各將牌庫頂的五張牌置入墳墓場。]]></LOCALISED_TEXT>
    <RESOLUTION_TIME_ACTION>
    local numPlayers = MTG():GetNumberOfPlayers()
    for i = 0, (numPlayers-1) do
    	local player = MTG():GetNthPlayer(i)
    	
