    <LOCALISED_TEXT LanguageCode="en-US"><![CDATA[Each player sacrifices a creature.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="fr-FR"><![CDATA[Chaque joueur sacrifie une créature.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="es-ES"><![CDATA[Cada jugador sacrifica una criatura.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="de-DE"><![CDATA[Jeder Spieler opfert eine Kreatur.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="it-IT"><![CDATA[Ogni giocatore sacrifica una creatura.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[各プレイヤーはそれぞれクリーチャーを１体生け贄に捧げる。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[각 플레이어는 생물 한 개를 희생한다.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[Каждый игрок приносит в жертву существо.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[Cada jogador sacrifica uma criatura.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[每位牌手各牺牲一个生物。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[每位玩家各犧牲一個生物。]]></LOCALISED_TEXT>
    <RESOLUTION_TIME_ACTION repeating="1">
    local n = MTG():GetActionRepCount()			
    local num_players = MTG():GetNumberOfPlayers()
    	
    if (n &lt; num_players) then
    	local player = MTG():GetNthPlayer(n)
    	local filter = ClearFilter()
    	filter:Add( FE_TYPE, OP_IS, CARD_TYPE_CREATURE )
    	filter:Add( FE_CONTROLLER, OP_IS, player )
    	player:ChooseItem( "CARD_QUERY_CHOOSE_CREATURE_TO_SACRIFICE", EffectDC():Make_Targets(n) )
    		return true
    else
    	for i=0,(num_players-1) do
    		local creature = EffectDC():Get_Targets(i):Get_CardPtr(0)
    		if creature ~= nil then
    			MTG():GetNthPlayer(i):Sacrifice( creature )
    		end
    	end
    	return false
    end
    </RESOLUTION_TIME_ACTION>
  </SPELL_ABILITY>
  <AI_BASE_SCORE score="750" zone="ZONE_HAND" />
