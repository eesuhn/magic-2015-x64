  <TRIGGERED_ABILITY>
    <LOCALISED_TEXT LanguageCode="en-US"><![CDATA[At the beginning of your upkeep, if you have 40 or more life, you win the game.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="fr-FR"><![CDATA[Au début de votre entretien, si vous avez au moins 40 points de vie, vous gagnez la partie.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="es-ES"><![CDATA[Al comienzo de tu mantenimiento, si tienes 40 o más vidas, ganas el juego.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="de-DE"><![CDATA[Falls du zu Beginn deines Versorgungssegments 40 Lebenspunkte oder mehr hast, gewinnst du die Partie.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="it-IT"><![CDATA[All’inizio del tuo mantenimento, se hai 40 o più punti vita, vinci la partita.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[あなたのアップキープの開始時に、あなたのライフが40点以上である場合、あなたはこのゲームに勝利する。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[당신의 유지단 시작에, 당신의 생명점이 40 이상이라면 당신은 게임에서 승리한다.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[В начале вашего шага поддержки, если у вас 40 жизней или больше, вы выигрываете партию.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[No início de sua manutenção, se tiver 40 ou mais pontos de vida, você vence o jogo.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[在你的维持开始时，若你的总生命为40或更多，你便赢得此盘游戏。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[在你的維持開始時，若你有40點或更多生命，你便贏得此盤遊戲。]]></LOCALISED_TEXT>
    <TRIGGER value="BEGINNING_OF_PLAYERS_STEP" simple_qualifier="controller">
    return MTG():GetStep() == STEP_UPKEEP
    </TRIGGER>
    <INTERVENING_IF>
    if EffectController():GetLifeTotal() &gt;= 40 then
    	return true
    else
    	return false
    end
    </INTERVENING_IF>
    <RESOLUTION_TIME_ACTION>
    EffectController():WinGame(EffectSourceLKI())
    </RESOLUTION_TIME_ACTION>
  </TRIGGERED_ABILITY>
