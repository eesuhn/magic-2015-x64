  <TRIGGERED_ABILITY replacement_effect="1" active_zone="ZONE_BATTLEFIELD">
    <LOCALISED_TEXT LanguageCode="en-US"><![CDATA[Creature spells with flying you cast cost {1} less to cast.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="fr-FR"><![CDATA[Les sorts de créature avec le vol que vous lancez coûtent {1} de moins à lancer.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="es-ES"><![CDATA[Te cuesta {1} menos lanzar los hechizos de criatura con la habilidad de volar.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="de-DE"><![CDATA[Kreaturenzauber mit Flugfähigkeit, die du wirkst, kosten beim Wirken {1} weniger.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="it-IT"><![CDATA[Le magie creatura con volare che lanci costano {1} in meno per essere lanciate.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[あなたが唱える飛行を持つクリーチャー呪文を唱えるためのコストが{1}少なくなる。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[당신이 발동하는 비행을 가진 생물 주문은 {1}이 덜 든다.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[Разыгрываемые вами заклинания существ с Полетом стоят на {1} меньше.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[As mágicas de criatura com voar que você conjura custam {1} a menos para serem conjuradas.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[由你施放且具飞行异能的生物咒语减少{1}来施放。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[由你施放且具飛行異能的生物咒語減少{1}來施放。]]></LOCALISED_TEXT>
    <TRIGGER value="CONSIDERED_FOR_CAST" pre_trigger="1">
    return TriggerPlayer() == EffectController() and TriggerObject():GetCardType():Test(CARD_TYPE_CREATURE) and TriggerObject():GetCurrentCharacteristics():Bool_Get( CHARACTERISTIC_FLYING)
    </TRIGGER>
    <RESOLUTION_TIME_ACTION>
    if TriggerObject() ~= nil then
    	TriggerObject():DecreaseCost( 1 )
    end
    </RESOLUTION_TIME_ACTION>
  </TRIGGERED_ABILITY>
