  <TRIGGERED_ABILITY>
    <LOCALISED_TEXT LanguageCode="en-US"><![CDATA[When Jugan, the Rising Star dies, you may distribute five +1/+1 counters among any number of target creatures.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="fr-FR"><![CDATA[Quand Jugan, l’étoile ascendante meurt, vous pouvez répartir cinq marqueurs +1/+1 sur n’importe quel nombre de créatures ciblées.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="es-ES"><![CDATA[Cuando Jugan, la estrella ascendente muera, puedes distribuir cinco contadores +1/+1 entre cualquier cantidad de criaturas objetivo.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="de-DE"><![CDATA[Wenn Jugan, der aufstrebende Stern, stirbt, kannst du fünf +1/+1-Marken auf eine beliebige Anzahl an Kreaturen deiner Wahl verteilen.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="it-IT"><![CDATA[Quando Jugan, Stella Nascente muore, puoi distribuire cinque segnalini +1/+1 tra un qualsiasi numero di creature bersaglio.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[昇る星、珠眼が死亡したとき、望む数のクリーチャーを対象とする。あなたはそれらに、合計５個の＋１/＋１カウンターを望むように割り振って置いてもよい。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[떠오르는 별 주간이 죽을 때, 원하는 만큼의 생물을 목표로 정한다. 당신은 그 생물들에 +1/+1 카운터 다섯 개를 원하는 대로 올려놓을 수 있다.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[Когда Юган, Восходящая Звезда умирает, вы можете распределить пять жетонов +1/+1 между любым количеством целевых существ.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[Quando Jugan, a Estrela Ascendente, morre, você pode distribuir cinco marcadores +1/+1 entre qualquer número de criaturas alvo.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[当碧龙珠眼死去时，你可以将五个+1/+1指示物分配至任意数量的目标生物上。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[當碧龍珠眼死去時，你可以將五個+1/+1指示物以任意方法分配至任意數量的目標生物上。]]></LOCALISED_TEXT>
    <TRIGGER value="ZONECHANGE_BEGIN" simple_qualifier="self" to_zone="ZONE_GRAVEYARD" from_zone="ZONE_BATTLEFIELD" />
    <TARGET tag="CARD_QUERY_CHOOSE_CREATURE_PLUS1_PLUS1_COUNTERS" definition="0" compartment="0" count="5" up_to="1" counter_assignment="1" />
    <TARGET_DEFINITION id="0">
    local filter = ClearFilter()
    filter:Add( FE_TYPE, OP_IS, CARD_TYPE_CREATURE )
    </TARGET_DEFINITION>
    <RESOLUTION_TIME_ACTION>
    local targetDC = EffectDC():Get_Targets(0)
    for i=0,4 do
    	local target_creature = targetDC:Get_CardPtr(i)
    	local number = targetDC:Get_Assignment(i)
    	if ( target_creature ~= nil ) then   
    		target_creature:AddCounters( MTG():PlusOnePlusOneCounters() , number )
    	end
    end
    </RESOLUTION_TIME_ACTION>
    <MAY />
    <AI_SIMPLIFIED_TARGETING compartment="0" hint="HINT_ALLIED_ONLY" />
