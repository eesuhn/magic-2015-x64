  <SPELL_ABILITY>
    <LOCALISED_TEXT LanguageCode="en-US"><![CDATA[|Domain| — Target creature gets -1/-1 until end of turn for each basic land type among lands you control.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="fr-FR"><![CDATA[|Domaine| — La créature ciblée gagne -1/-1 jusqu’à la fin du tour pour chaque type de terrain de base parmi les terrains que vous contrôlez.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="es-ES"><![CDATA[|Dominio| — La criatura objetivo obtiene -1/-1 hasta el final del turno por cada tipo de tierra básica entre las tierras que controlas.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="de-DE"><![CDATA[|Domäne| — Eine Kreatur deiner Wahl erhält bis zum Ende des Zuges -1/-1 für jeden Standardlandtyp unter den Ländern, die du kontrollierst.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="it-IT"><![CDATA[|Dominio| — Una creatura bersaglio prende -1/-1 fino alla fine del turno per ogni tipo di terra base tra le terre che controlli.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[|版図| ― クリーチャー１体を対象とする。それはターン終了時まで、あなたがコントロールする土地の中の基本土地タイプ１つにつき－１/－１の修整を受ける。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[도메인 — 생물 한 개를 목표로 정한다. 그 생물은 턴종료까지 당신이 조종하는 대지의 각 기본 대지 유형마다 -1/-1을 받는다.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[|Владения| — Целевое существо получает -1/-1 до конца хода за каждый тип базовой земли среди земель под вашим контролем.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[|Dominar| — A criatura alvo recebe -1/-1 até o final do turno para cada tipo de terreno básico entre os terrenos que você controla.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[领土～由你操控的地之中每有一种基本地类别，目标生物便得-1/-1直到回合结束。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[領土～由你操控的地之中每有一種基本地類別，目標生物便得-1/-1直到回合結束。]]></LOCALISED_TEXT>
    <SFX text="TARGET_PESTS_PLAY" />
    <TARGET tag="CARD_QUERY_CHOOSE_A_CREATURE" definition="0" compartment="0" count="1">
    if EffectController():GetDomainCount() == 1 then
    	MTG():SetTargetTag("CARD_QUERY_CHOOSE_CREATURE_TO_LOSE_1_1")
    elseif EffectController():GetDomainCount() == 2 then
    	MTG():SetTargetTag("CARD_QUERY_CHOOSE_CREATURE_TO_LOSE_2_2")
    elseif EffectController():GetDomainCount() == 3 then
    	MTG():SetTargetTag("CARD_QUERY_CHOOSE_CREATURE_TO_LOSE_3_3")
    elseif EffectController():GetDomainCount() == 4 then
    	MTG():SetTargetTag("CARD_QUERY_CHOOSE_CREATURE_TO_LOSE_4_4")
    elseif EffectController():GetDomainCount() == 5 then
    	MTG():SetTargetTag("CARD_QUERY_CHOOSE_CREATURE_TO_LOSE_5_5")
    end
    </TARGET>
    <TARGET_DEFINITION id="0">
    local filter = ClearFilter()
    filter:Add( FE_TYPE, OP_IS, CARD_TYPE_CREATURE )
    </TARGET_DEFINITION>
    <RESOLUTION_TIME_ACTION>
    EffectDC():Set_Int(1, EffectController():GetDomainCount())
    </RESOLUTION_TIME_ACTION>
    <CONTINUOUS_ACTION layer="7C">
    local target = EffectDC():Get_Targets(0):Get_CardPtr(0)
    local number = EffectDC():Get_Int(1)
    if target ~= nil and number ~= 0 then
    	local characteristics = target:GetCurrentCharacteristics()
    	characteristics:Power_Add( -number )
    	characteristics:Toughness_Add( -number )
    end
    </CONTINUOUS_ACTION>
    <DURATION simple_duration="UntilEOT" />
    <AI_SIMPLIFIED_TARGETING compartment="0" hint="HINT_ENEMY_ONLY" />
  </SPELL_ABILITY>
