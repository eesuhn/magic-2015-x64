  <STATIC_ABILITY>
    <LOCALISED_TEXT LanguageCode="en-US"><![CDATA[Enchanted creature gets +2/+2 and can’t block.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="fr-FR"><![CDATA[La créature enchantée gagne +2/+2 et ne peut pas bloquer.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="es-ES"><![CDATA[La criatura encantada obtiene +2/+2 y no puede bloquear.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="de-DE"><![CDATA[Die verzauberte Kreatur erhält +2/+2 und kann nicht blocken.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="it-IT"><![CDATA[La creatura incantata prende +2/+2 e non può bloccare.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[エンチャントされているクリーチャーは、＋２/＋２の修整を受けるとともに、それではブロックできない。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[부여된 생물은 +2/+2를 받으며 방어할 수 없다.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[Зачарованное существо получает +2/+2 и не может блокировать.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[A criatura encantada recebe +2/+2 e não pode bloquear.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[所结附的生物得+2/+2且不能进行阻挡。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[所結附的生物得+2/+2且不能進行阻擋。]]></LOCALISED_TEXT>
    <CONTINUOUS_ACTION layer="7C">
    if EffectSource()~= nil then
    	local parent = EffectSource():GetParent()
    	if parent ~= nil then
    		parent:GetCurrentCharacteristics():Power_Add( 2 )
    		parent:GetCurrentCharacteristics():Toughness_Add( 2 )
    	end
    end
    </CONTINUOUS_ACTION>
    <CONTINUOUS_ACTION layer="8">
    local parent = EffectSource():GetParent()
    if parent ~= nil then
    	parent:GetCurrentCharacteristics():Bool_Set( CHARACTERISTIC_CANT_BLOCK, 1 )
    end
    </CONTINUOUS_ACTION>
  </STATIC_ABILITY>
