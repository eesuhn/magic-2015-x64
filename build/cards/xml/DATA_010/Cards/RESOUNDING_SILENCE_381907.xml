  <TRIGGERED_ABILITY active_zone="ZONE_HAND">
    <LOCALISED_TEXT LanguageCode="en-US"><![CDATA[When you cycle Resounding Silence, exile up to two target attacking creatures.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="fr-FR"><![CDATA[Quand vous recyclez le Silence retentissant, exilez jusqu’à deux créatures attaquantes ciblées.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="es-ES"><![CDATA[Cuando uses la habilidad de ciclo del Silencio resonante, exilia hasta dos criaturas atacantes objetivo.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="de-DE"><![CDATA[Wenn du die Dröhnende Stille umwandelst, schicke bis zu zwei angreifende Kreaturen deiner Wahl ins Exil.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="it-IT"><![CDATA[Quando cicli il Silenzio Echeggiante, esilia fino a due creature attaccanti bersaglio.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[あなたが圧倒する静寂をサイクリングしたとき、攻撃クリーチャーを最大２体まで対象とし、それらを追放する。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[울려 퍼지는 침묵을 순환할 때, 공격생물을 두 개까지 목표로 정한다. 그 생물들을 추방한다.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[Когда вы совершаете Цикл Гулкой Тишины, изгоните не более двух целевых атакующих существ.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[Quando reciclar Silêncio Ressonante, exile até duas criaturas alvo atacantes.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[当你循环轰然静寂时，放逐至多两个目标进行攻击的生物。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[當你循環轟然靜寂時，放逐至多兩個目標進行攻擊的生物。]]></LOCALISED_TEXT>
    <TRIGGER value="CYCLED" simple_qualifier="self" />
    <TARGET tag="CARD_QUERY_CHOOSE_CREATURE_TO_EXILE" definition="0" compartment="0" count="2" up_to="1" />
    <TARGET_DEFINITION id="0">
    local filter = ClearFilter()
    filter:Add( FE_TYPE, OP_IS, CARD_TYPE_CREATURE )
    filter:Add( FE_IS_ATTACKING, true )
    </TARGET_DEFINITION>
    <RESOLUTION_TIME_ACTION>
    for i = 0,(2-1) do
    	local target_card = EffectDC():Get_Targets(0):Get_CardPtr(i)
    	if target_card ~= nil  then
    		target_card:Exile()
    	end
    end
    </RESOLUTION_TIME_ACTION>
  </TRIGGERED_ABILITY>
