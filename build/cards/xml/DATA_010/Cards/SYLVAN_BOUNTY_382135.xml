    <PLAY_TIME_ACTION>
    MTG():FireTrigger( TRIGGER_CYCLED, EffectSource() )
    </PLAY_TIME_ACTION>
    <RESOLUTION_TIME_ACTION>
    local effectController = EffectController()
    local filter = ClearFilter()
    filter:Add( FE_SUPERTYPE, OP_IS, SUPERTYPE_BASIC )
    filter:Add( FE_TYPE, OP_IS, CARD_TYPE_LAND )
    filter:SetZone( ZONE_LIBRARY, effectController)
    effectController:ChooseItem( "CARD_QUERY_CHOOSE_BASIC_LAND_PUT_INTO_HAND", EffectDC():Make_Targets(0) )
    </RESOLUTION_TIME_ACTION>
    <RESOLUTION_TIME_ACTION>
    local target = EffectDC():Get_Targets(0):Get_CardPtr(0)
    if  target ~= nil then
    	target:GuidedReveal( target:GetZone(), ZONE_HAND )
    end  
    </RESOLUTION_TIME_ACTION>
    <RESOLUTION_TIME_ACTION>
    local target = EffectDC():Get_Targets(0):Get_CardPtr(0)
    if  target ~= nil then
    	target:PutInHand()
    end  
    </RESOLUTION_TIME_ACTION>
    <RESOLUTION_TIME_ACTION>
    EffectController():ShuffleLibrary()
    </RESOLUTION_TIME_ACTION>
