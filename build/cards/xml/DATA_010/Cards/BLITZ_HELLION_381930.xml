  <TRIGGERED_ABILITY>
    <LOCALISED_TEXT LanguageCode="en-US"><![CDATA[At the beginning of the end step, Blitz Hellion’s owner shuffles it into his or her library.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="fr-FR"><![CDATA[Au début de l’étape de fin, le propriétaire de la Monstruosité à l’attaque-éclair la mélange dans sa bibliothèque.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="es-ES"><![CDATA[Al comienzo del paso final, el propietario del Infernal devastador lo baraja en su biblioteca.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="de-DE"><![CDATA[Zu Beginn des Endsegments mischt der Besitzer des Blitzschnellen Teufelsbratens ihn in seine Bibliothek.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="it-IT"><![CDATA[All’inizio della sottofase finale, il proprietario dell’Infernale Incursore lo rimescola nel suo grimorio.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[終了ステップの開始時に、襲撃の乱暴者をオーナーのライブラリーに加えて切り直す。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[종료단 시작에, 전격 헬리온의 소유자는 전격 헬리온을 자신의 서고로 섞어 넣는다.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[В начале заключительного шага владелец Стремительного Геллиона втасовывает его в свою библиотеку.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[No início da etapa final, o dono de Avernal do Ataque-relâmpago o embaralha em seu próprio grimório.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[在结束步骤开始时，闪击地狱兽的拥有者将它洗入其牌库。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[在結束步驟開始時，閃擊地獄獸的擁有者將它洗入其牌庫。]]></LOCALISED_TEXT>
    <TRIGGER value="BEGINNING_OF_STEP">
    return MTG():GetStep() == STEP_END_OF_TURN
    </TRIGGER>
    <RESOLUTION_TIME_ACTION>
    local controller = EffectSource():GetOwner()
    EffectDC():Make_Targets(0):Set_PlayerPtr(1, controller)
    </RESOLUTION_TIME_ACTION>
    <RESOLUTION_TIME_ACTION>
    if EffectSource() ~= nil then
    	EffectSource():PutOnTopOfLibrary()	
    end
    </RESOLUTION_TIME_ACTION>
    <RESOLUTION_TIME_ACTION>
    local playerDC = EffectDC():Get_Targets(0)
    if playerDC ~= nil then
    	local player = EffectDC():Get_Targets(0):Get_PlayerPtr(1)
    	if player ~= nil then
    		player:ShuffleLibrary()
    	end
    end
    </RESOLUTION_TIME_ACTION>
    <AI_MODIFIERS worthless="1" />
  </TRIGGERED_ABILITY>
