  <TRIGGERED_ABILITY>
    <LOCALISED_TEXT LanguageCode="en-US"><![CDATA[When Howling Banshee enters the battlefield, each player loses 3 life.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="fr-FR"><![CDATA[Quand la Banshee hurlante arrive sur le champ de bataille, chaque joueur perd 3 points de vie.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="es-ES"><![CDATA[Cuando la Banshee aulladora entre al campo de batalla, cada jugador pierde 3 vidas.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="de-DE"><![CDATA[Wenn die Heulende Todesfee ins Spiel kommt, verliert jeder Spieler 3 Lebenspunkte.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="it-IT"><![CDATA[Quando la Banshee Ululante entra nel campo di battaglia, ogni giocatore perde 3 punti vita.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="jp-JA"><![CDATA[吠えたけるバンシーが戦場に出たとき、各プレイヤーは３点のライフを失う。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ko-KR"><![CDATA[포효하는 밴시가 전장에 들어올 때, 각 플레이어는 생명 3점을 잃는다.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="ru-RU"><![CDATA[Когда Воющая Баньши выходит на поле битвы, каждый игрок теряет 3 жизни.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="pt-BR"><![CDATA[Quando Banshee Clamante entra no campo de batalha, cada jogador perde 3 pontos de vida.]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-CN"><![CDATA[当哭号女妖进战场时，每位牌手各失去3点生命。]]></LOCALISED_TEXT>
    <LOCALISED_TEXT LanguageCode="zh-HK"><![CDATA[當哭號女妖進戰場時，每位玩家各失去3點生命。]]></LOCALISED_TEXT>
    <TRIGGER value="ZONECHANGE_END" simple_qualifier="self" to_zone="ZONE_BATTLEFIELD" />
    <RESOLUTION_TIME_ACTION>
    local number = MTG():GetNumberOfPlayers()
    for i=0,(number-1) do
    	local player = MTG():GetNthPlayer(i)
    	if player ~= nil then
    		player:LoseLife( 3 )
    	end
    end
    </RESOLUTION_TIME_ACTION>
  </TRIGGERED_ABILITY>
